# Local dev: docker compose up -d, then this matches docker-compose.yml.
# Production: the pooled Neon connection string (Vercel project env vars).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio_guestbook

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, the production URL on Vercel
BETTER_AUTH_URL=http://localhost:3000

# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare Turnstile widget for this domain
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated Discord user IDs allowed on /guestbook/admin
ADMIN_DISCORD_IDS=

# Random pepper mixed into the hashed IP used for guestbook rate-limiting
IP_HASH_SALT=
